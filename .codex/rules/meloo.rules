# Chặn lệnh nguy hiểm cho Codex trong repo Meloo.
# Chỉ nạp khi project .codex/ được tin cậy (trust). Khởi động lại Codex sau khi sửa file này.
# Thử luật: codex execpolicy check --pretty --rules .codex/rules/meloo.rules -- gh pr merge 12

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "Chỉ Thái được merge PR (AGENTS.md, luật 10).",
    match = ["gh pr merge 12 --squash"],
    not_match = ["gh pr view 12"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Không force push trần. Dùng git push --force-with-lease trên branch của ticket.",
    match = ["git push --force origin feat/MEL-1-demo", "git push -f"],
    not_match = ["git push --force-with-lease origin feat/MEL-1-demo"],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["main", "HEAD:main"]],
    decision = "forbidden",
    justification = "main chỉ nhận thay đổi qua PR.",
    match = ["git push origin main", "git push origin HEAD:main"],
    not_match = ["git push origin feat/MEL-1-demo"],
)

# Luật khớp token theo vị trí nên phải liệt kê: chặn 1–3 option đứng trước "origin main", và
# --force/-f đứng sau 1–2 option. Repo private gói Free không có branch protection, nên dạng lệnh
# ngoài danh sách (VD --force-with-lease=<ref>, remote khác "origin") chỉ còn luật trong AGENTS.md chặn.
PUSH_OPTS = ["-u", "--set-upstream", "--force-with-lease", "--no-verify", "-v", "--verbose"]
MAIN = ["main", "HEAD:main"]

prefix_rule(
    pattern = ["git", "push", PUSH_OPTS, "origin", MAIN],
    decision = "forbidden",
    justification = "main chỉ nhận thay đổi qua PR.",
    match = ["git push -u origin main", "git push --force-with-lease origin HEAD:main"],
    not_match = ["git push -u origin chore/MEL-21-monorepo-setup", "git push --force-with-lease origin chore/MEL-21-monorepo-setup"],
)

prefix_rule(
    pattern = ["git", "push", PUSH_OPTS, PUSH_OPTS, "origin", MAIN],
    decision = "forbidden",
    justification = "main chỉ nhận thay đổi qua PR.",
    match = ["git push -u --force-with-lease origin main", "git push --force-with-lease -u origin HEAD:main"],
    not_match = ["git push -u --force-with-lease origin chore/MEL-21-monorepo-setup"],
)

prefix_rule(
    pattern = ["git", "push", PUSH_OPTS, PUSH_OPTS, PUSH_OPTS, "origin", MAIN],
    decision = "forbidden",
    justification = "main chỉ nhận thay đổi qua PR.",
    match = ["git push -u --force-with-lease --no-verify origin main"],
    not_match = ["git push -u --force-with-lease --no-verify origin chore/MEL-21-monorepo-setup"],
)

prefix_rule(
    pattern = ["git", "push", PUSH_OPTS, ["--force", "-f"]],
    decision = "forbidden",
    justification = "Không force push trần. Dùng git push --force-with-lease trên branch của ticket.",
    match = ["git push -u --force origin chore/MEL-21-monorepo-setup", "git push -u -f"],
    not_match = ["git push -u --force-with-lease origin chore/MEL-21-monorepo-setup"],
)

prefix_rule(
    pattern = ["git", "push", PUSH_OPTS, PUSH_OPTS, ["--force", "-f"]],
    decision = "forbidden",
    justification = "Không force push trần. Dùng git push --force-with-lease trên branch của ticket.",
    match = ["git push -u --no-verify --force origin chore/MEL-21-monorepo-setup"],
)

prefix_rule(
    pattern = ["gh", "pr", "review"],
    decision = "prompt",
    justification = "Reviewer đăng nhận xét bằng gh pr comment; approve là việc của Thái.",
    match = ["gh pr review 12 --approve"],
)

prefix_rule(
    pattern = ["orca-ide", "orchestration", "reset"],
    decision = "forbidden",
    justification = "Cấm reset orchestration để tránh mất phiên điều phối.",
    match = ["orca-ide orchestration reset"],
)

prefix_rule(
    pattern = ["orca-ide", "orchestration"],
    decision = "allow",
    justification = "Cho phép điều phối công việc qua Orca orchestration.",
    match = ["orca-ide orchestration status"],
    not_match = ["orca-ide status"],
)

prefix_rule(
    pattern = ["orca-ide", "worktree", "rm"],
    decision = "forbidden",
    justification = "Cấm xóa worktree để tránh mất mã nguồn chưa commit.",
    match = ["orca-ide worktree rm feat/MEL-1"],
)

