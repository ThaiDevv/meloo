# Quy ước định dạng chung. Formatter của từng phía (Spotless, Prettier) là nguồn quyết định cuối.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,mjs,cjs,json,css,html,yml,yaml,toml,md,puml}]
indent_style = space
indent_size = 2

[*.{sh,py}]
indent_style = space
indent_size = 4

# Hai dấu cách cuối dòng là ngắt dòng trong Markdown.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
