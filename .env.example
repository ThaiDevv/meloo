# Database (PostgreSQL)
POSTGRES_DB=meloo
POSTGRES_USER=meloo
POSTGRES_PASSWORD=meloo
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/meloo
DB_USERNAME=meloo
DB_PASSWORD=meloo

# Meloo CORS
MELOO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Meloo Security / JWT (HS256 requires minimum 32 bytes / 256 bits)
MELOO_JWT_SECRET=meloo-local-development-secret-key-at-least-256-bits-length
