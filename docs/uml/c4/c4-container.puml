@startuml c4-container
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Sơ đồ C4 Container - Hệ thống đoán nhạc Meloo (C4 Level 2)

Person(user, "Người chơi (Guest / Member / Admin)", "Người dùng truy cập Meloo qua trình duyệt web trên máy tính hoặc thiết bị di động.")

System_Boundary(c1, "Hệ thống Meloo") {
    Container(fe, "Single-Page Application (SPA)", "React 19, TypeScript, Vite, Tailwind CSS, Zustand, TanStack Query", "Giao diện web game, xử lý phát preview Web Audio API, điều khiển phòng chơi và chat. Triển khai trên Vercel.")
    
    Container(caddy, "Reverse Proxy & TLS Gateway", "Caddy 2, Docker", "Đóng vai trò Gateway tại EC2, tự động cấp và gia hạn HTTPS Let's Encrypt, chuyển tiếp reverse proxy HTTPS và WSS vào backend.")
    
    Container(be, "Backend Application (Modular Monolith)", "Spring Boot 4.x, Java 21, Spring Modulith, Spring Security, STOMP Simple Broker", "Cung cấp REST API, quản lý phiên và xác thực JWT/Cookie, điều phối phòng chơi (in-memory queue), streaming proxy audio HMAC.")
    
    ContainerDb(db, "Cơ sở dữ liệu (Database)", "PostgreSQL 17, AWS RDS", "Lưu trữ tài khoản, phân quyền, danh mục bài hát, ca sĩ, bộ đề, lịch sử đấu, tổng điểm các trận xếp hạng (BR-24) và thử thách ngày.")
}

System_Ext(auth_providers, "Google OAuth 2.0 / Facebook", "Dịch vụ xác thực danh tính người dùng qua Google OAuth 2.0 (FR-02) và Facebook Login (FR-03, S5).")
System_Ext(deezer, "Deezer Music API & CDN", "Dịch vụ cung cấp thông tin bài hát và luồng MP3 128 kbps (30s preview).")

Rel(user, fe, "Tương tác giao diện người dùng", "HTTPS")
Rel(fe, caddy, "Gửi API request và kết nối WebSocket", "HTTPS, WSS (JSON, STOMP)")
Rel(caddy, be, "Chuyển tiếp yêu cầu nội bộ", "HTTP (port 8080), WS")
Rel(be, db, "Đọc / ghi dữ liệu quan hệ", "JDBC / PostgreSQL (port 5432)")

Rel(be, auth_providers, "Xác minh token định danh người dùng", "HTTPS / REST")
Rel(be, deezer, "Tìm kiếm bài hát & lấy luồng preview", "HTTPS / REST")


@enduml
