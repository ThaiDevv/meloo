@startuml uc-08-doan-bai-hat-trong-vong
title UC-08: Đoán bài hát trong vòng (phân hệ Chơi đơn / nhiều người)
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 90
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

actor "Khách" as A1
rectangle "<<actor>>\n**Hệ thống API nhạc**" as X1
rectangle "**Meloo — UC-08**" {
  usecase "UC-08\nĐoán bài hát trong vòng" as UC08
  usecase "UC-06\nTìm bài hát" as UC06
  usecase "UC-07\nChơi luyện tập" as UC07
  usecase "UC-09\nMở thêm mức nghe" as UC09
  usecase "UC-10\nLàm thử thách hằng ngày" as UC10
  usecase "UC-18\nChơi trận nhiều người" as UC18
}
A1 -- UC08
UC08 ..> UC06 : <<include>>
UC09 ..> UC08 : <<extend>>
UC07 ..> UC08 : <<include>>
UC10 ..> UC08 : <<include>>
UC18 ..> UC08 : <<include>>
UC08 -- X1
@enduml
