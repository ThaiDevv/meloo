@startuml uc-10-thu-thach-hang-ngay
title UC-10: Làm thử thách hằng ngày (phân hệ Chơi đơn)
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 90
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

actor "Khách" as A1
rectangle "**Meloo — UC-10**" {
  usecase "UC-10\nLàm thử thách hằng ngày" as UC10
  usecase "UC-08\nĐoán bài hát trong vòng" as UC08
  usecase "UC-11\nChia sẻ kết quả thử thách ngày" as UC11
}
A1 -- UC10
UC10 ..> UC08 : <<include>>
UC11 ..> UC10 : <<extend>>
@enduml
