@startuml uc-15-ghep-tran-nhanh
title UC-15: Ghép trận nhanh (phân hệ Chơi nhiều người)
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 90
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

actor "Khách" as A1
rectangle "**Meloo — UC-15**" {
  usecase "UC-15\nGhép trận nhanh" as UC15
}
A1 -- UC15
@enduml
