@startuml uc-17-bat-dau-tran
title UC-17: Bắt đầu trận (phân hệ Chơi nhiều người)
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 90
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

actor "Chủ phòng" as A1
rectangle "**Meloo — UC-17**" {
  usecase "UC-17\nBắt đầu trận" as UC17
}
A1 -- UC17
@enduml
