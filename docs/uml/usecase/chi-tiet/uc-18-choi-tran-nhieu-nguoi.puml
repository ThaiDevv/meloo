@startuml uc-18-choi-tran-nhieu-nguoi
title UC-18: Chơi trận nhiều người (phân hệ Chơi nhiều người)
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 90
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

actor "Khách" as A1
rectangle "<<actor>>\n**Hệ thống API nhạc**" as X1
rectangle "**Meloo — UC-18**" {
  usecase "UC-18\nChơi trận nhiều người" as UC18
  usecase "UC-08\nĐoán bài hát trong vòng" as UC08
}
A1 -- UC18
UC18 ..> UC08 : <<include>>
UC18 -- X1
@enduml
