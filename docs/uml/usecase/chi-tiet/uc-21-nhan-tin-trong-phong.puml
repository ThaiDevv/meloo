@startuml uc-21-nhan-tin-trong-phong
title UC-21: Nhắn tin trong phòng (phân hệ Giao tiếp)
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 90
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

actor "Khách" as A1
rectangle "**Meloo — UC-21**" {
  usecase "UC-21\nNhắn tin trong phòng" as UC21
  usecase "UC-22\nBáo cáo tin nhắn vi phạm" as UC22
}
A1 -- UC21
UC22 ..> UC21 : <<extend>>
@enduml
