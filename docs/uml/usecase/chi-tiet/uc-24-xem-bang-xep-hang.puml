@startuml uc-24-xem-bang-xep-hang
title UC-24: Xem bảng xếp hạng (phân hệ Xếp hạng)
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 90
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

actor "Khách" as A1
rectangle "**Meloo — UC-24**" {
  usecase "UC-24\nXem bảng xếp hạng" as UC24
}
A1 -- UC24
@enduml
