@startuml uc-30-xu-ly-bao-cao-vi-pham
title UC-30: Xử lý báo cáo vi phạm (phân hệ Quản trị)
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 90
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

actor "Quản trị viên" as A1
rectangle "**Meloo — UC-30**" {
  usecase "UC-30\nXử lý báo cáo vi phạm" as UC30
  usecase "UC-29\nKhóa tài khoản hoặc khách" as UC29
  usecase "UC-31\nQuản lý từ cấm" as UC31
}
A1 -- UC30
UC29 ..> UC30 : <<extend>>
UC31 ..> UC30 : <<extend>>
@enduml
