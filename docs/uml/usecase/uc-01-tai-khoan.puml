@startuml uc-01-tai-khoan
title Use case phân hệ Tài khoản (FR-01 → FR-04)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Khách" as Khach
actor "Người chơi\n(đã đăng nhập)" as NguoiChoi
actor "Nhà cung cấp OAuth\n(Google, Facebook)" as OAuth

NguoiChoi --|> Khach

rectangle "Tài khoản" {
  usecase "UC-01\nVào chơi bằng biệt danh" as UC01
  usecase "UC-02\nĐăng nhập bằng tài khoản\nmạng xã hội" as UC02
  usecase "UC-03\nGộp dữ liệu khách" as UC03
  usecase "UC-04\nXem hồ sơ và thống kê cá nhân" as UC04
  usecase "UC-05\nXóa tài khoản" as UC05
}

Khach --> UC01
Khach --> UC02
NguoiChoi --> UC04
NguoiChoi --> UC05

UC02 ..> UC03 : <<include>>
UC02 -- OAuth

note right of UC02
  Google: Must (FR-02).
  Facebook: Should (FR-03).
end note
@enduml
