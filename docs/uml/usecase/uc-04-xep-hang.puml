@startuml uc-04-xep-hang
title Use case phân hệ Xếp hạng và tiến trình (FR-13 → FR-15)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Khách" as Khach
actor "Người chơi\n(đã đăng nhập)" as NguoiChoi

NguoiChoi --|> Khach

rectangle "Xếp hạng và tiến trình" {
  usecase "UC-24\nXem bảng xếp hạng" as UC24
  usecase "UC-25\nXem huy hiệu" as UC25
  usecase "UC-04\nXem hồ sơ và thống kê cá nhân" as UC04
}

Khach --> UC24
NguoiChoi --> UC25
NguoiChoi --> UC04

UC04 ..> UC25 : <<include>>

note bottom of UC24
  Ba bảng: tuần, toàn thời gian (tổng điểm trận xếp hạng, BR-24)
  và theo ngày (thử thách ngày, BR-25).
end note
@enduml
