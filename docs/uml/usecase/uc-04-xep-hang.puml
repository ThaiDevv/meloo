@startuml uc-04-xep-hang
title Use case phân hệ Xếp hạng và tiến trình (FR-13 → FR-15)
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 80
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

actor "Khách" as Khach
rectangle "**Meloo — Xếp hạng và tiến trình**" {
  usecase "UC-24\nXem bảng xếp hạng" as UC24
  usecase "UC-04\nXem hồ sơ và thống kê cá nhân" as UC04
  usecase "UC-25\nXem huy hiệu" as UC25
}
Khach -- UC24
Khach -- UC04
Khach -- UC25
UC04 ..> UC25 : <<include>>
@enduml
