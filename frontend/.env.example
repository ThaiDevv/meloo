# Copy to .env.local. Never commit real values.
# Backend origin only (no /api: contract paths already include /api/v1). Empty = same origin.
VITE_API_BASE_URL=
VITE_WS_URL=/ws
# Serve responses from MSW using contracts/examples instead of a real backend.
VITE_API_MOCK=false
# Feature flags: VITE_FEATURE_<NAME>
VITE_FEATURE_FACEBOOK_LOGIN=false
# Expose the /_ui gallery outside dev (Vercel preview).
VITE_PREVIEW=false
# Filled by INF-04
VITE_SENTRY_DSN=
