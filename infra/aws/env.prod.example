# ==============================================================================
# MELOO PRODUCTION ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Hướng dẫn trên EC2:
# 1. Sao chép file này sang .env: cp env.prod.example .env
# 2. Điền thông tin thực tế từ RDS endpoint và secret của dự án.
# 3. Phân quyền bảo mật tuyệt đối: chmod 600 .env
# ==============================================================================

# Backend image từ GHCR (sẽ được workflow CD INF-02 cập nhật hoặc kéo thủ công)
BACKEND_IMAGE=ghcr.io/thaidevv/meloo-backend:latest

# Tên miền và Email nhận thông báo chứng chỉ Let's Encrypt / ZeroSSL (bắt buộc)
API_DOMAIN=api.meloo.vn
ACME_EMAIL=admin@meloo.vn

# Kết nối cơ sở dữ liệu AWS RDS PostgreSQL 17 (Private Subnet, sslmode=require)
# Thay <rds-endpoint> bằng RDS Endpoint hiển thị trên AWS Console (vd: meloo-prod-db.c123456789.ap-southeast-1.rds.amazonaws.com)
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/meloo?sslmode=require
DB_USERNAME=meloo_admin
DB_PASSWORD=YOUR_STRONG_RDS_PASSWORD_HERE

# Danh sách domain frontend được phép CORS (phân tách bởi dấu phẩy)
# Bao gồm domain chính thức trên Vercel và localhost nếu cần debug
MELOO_CORS_ALLOWED_ORIGINS=https://meloo.vn,https://meloo.vercel.app

# JWT Secret Key (HMAC-SHA256 yêu cầu tối thiểu 32 bytes / 256 bits)
# Tạo bằng: openssl rand -base64 48
MELOO_JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_BASE64_STRING_AT_LEAST_32_BYTES

# Audio HMAC Secret Key để ký và giải mã token mờ phát nhạc (HMAC-SHA256 tối thiểu 32 bytes / 256 bits)
# Tạo bằng: openssl rand -base64 48 (bắt buộc khác MELOO_JWT_SECRET)
MELOO_AUDIO_HMAC_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_BASE64_STRING_DIFFERENT_FROM_JWT_SECRET

# Google OAuth (MEL-113): enable after creating a Google Web application client.
# Authorized redirect URI: https://<API_DOMAIN>/api/v1/auth/oauth2/google/callback
# Set real credentials only in /opt/meloo/.env on EC2; never commit them.
MELOO_GOOGLE_OAUTH_ENABLED=false
MELOO_GOOGLE_CLIENT_ID=
MELOO_GOOGLE_CLIENT_SECRET=
MELOO_SPA_ORIGIN=https://meloo.id.vn
