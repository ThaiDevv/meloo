{
	email {$ACME_EMAIL}
	admin off
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Reverse proxy tới Spring Boot backend
	# Caddy tự động hỗ trợ WebSocket upgrade (STOMP over WebSocket)
	# Không đặt trusted_proxies; ghi đè X-Forwarded-For bằng {remote_host} để backend luôn nhận IP kết nối thật (MEL-127)
	reverse_proxy backend:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
