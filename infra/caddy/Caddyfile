{
	# Global options
	email {$ACME_EMAIL:admin@meloo.vn}
	# Tắt admin API trên production nếu không cần thiết
	admin off
}

# Domain endpoint cho API backend
{$API_DOMAIN:api.meloo.vn} {
	encode zstd gzip

	# Security Headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Reverse proxy tới Spring Boot backend
	# Caddy tự động hỗ trợ WebSocket upgrade (STOMP over WebSocket) và gắn X-Forwarded-*
	reverse_proxy backend:8080 {
		header_up X-Real-IP {remote_host}
	}
}
