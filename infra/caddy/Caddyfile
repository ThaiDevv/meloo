{
	email {$ACME_EMAIL}
	admin off
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Giữ IP thực tế của client:
	# Mặc định dùng remote_host khi kết nối trực tiếp (DNS only).
	# Khi bật Cloudflare Proxy, tự động ghi đè bằng header CF-Connecting-IP.
	@has_cf header CF-Connecting-IP *
	reverse_proxy backend:8080 {
		header_up X-Real-IP {remote_host}
		header_up @has_cf X-Real-IP {header.CF-Connecting-IP}
	}
}
